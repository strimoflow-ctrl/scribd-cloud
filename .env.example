# =============================================================================
# SCRIBD CLOUD ENVIRONMENT VARIABLES CONFIGURATION (.env)
# =============================================================================

# 1. Telegram Bot Token (from @BotFather)
BOT_TOKEN=7488344589:AAEP6b8o9U_i-hOtdL5mK7Z-L1YJ4-0zT4I

# 2. Telegram Bot Username for Watermarks (Without @)
BOT_USERNAME=ScribdPdfDownloaderBot

# 3. Firebase Realtime Database URL (Spark Free Plan)
# Example: https://your-project-id-default-rtdb.firebaseio.com
FIREBASE_DB_URL=https://secret-gpt-default-rtdb.asia-southeast1.firebasedatabase.app

# Firebase Root Node (Queue and Cache prefix)
DB_ROOT=scribd_cloud

# 4. Kaggle REST API Credentials (For Zero-Downtime Auto-Restart)
# Generate from: Kaggle.com -> Account Settings -> Create New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
KAGGLE_SLUG=scribd-cloud-worker
KAGGLE_TITLE=Scribd Cloud Worker

# 5. Optional Residential Proxy (Leave empty if not using proxy)
# Example: http://username:password@ip:port
PROXY_URL=

# 6. Optional Force Subscribe Channel (e.g. @mychannel or leave empty)
FORCE_SUB_CHANNEL=

# 7. Worker Concurrency Settings (Kaggle 30GB RAM)
MAX_RUNTIME_HOURS=11.0
MAX_PARALLEL_RENDERS=10

# 8. Web Server Port (Automatically set by Render.com)
PORT=8080

